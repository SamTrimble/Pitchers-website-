PROJECT_NAME=AthleteOS Platform
ENVIRONMENT=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=******postgres:5432/athleteos
REDIS_URL=redis://redis:6379/0
AUTH_SECRET=replace-me
SUPABASE_URL=https://example.supabase.co
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
S3_BUCKET=athleteos-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_AUTH_STUB=true
DEFAULT_ORGANIZATION_HEADER=X-Organization-Id
